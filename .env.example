PORT=3001
# 默认绑定 127.0.0.1；需要局域网/隧道访问时设置 HOST=0.0.0.0 且必须配置 AUTH_TOKEN
HOST=127.0.0.1
AUTH_TOKEN=your-secret-token-here
WORK_DIR=/Users/you/projects
# 多工作目录（可选）：逗号分隔的额外目录白名单
WORK_DIRS=
CODEX_BIN=
IDLE_TIMEOUT_MS=600000
CODEX_INPUT_QUEUE_LIMIT=20
# 审批策略 untrusted|on-failure|on-request|granular|never
CODEX_APPROVAL_POLICY=on-request
# 沙箱 read-only|workspace-write|danger-full-access
CODEX_SANDBOX=workspace-write
# Web Push（可选，三项齐全才启用）：
# VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
