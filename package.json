{
  "name": "codex-chat-mobile",
  "version": "0.1.0",
  "description": "Mobile chat UI that bridges your local Codex CLI to your phone — terminal-equivalent agent access.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Ike-li (https://github.com/Ike-li)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "test:ci": "npm run lint && npm test && node scripts/check-coverage.js && npm run test:e2e",
    "coverage": "c8 node --test test/*.test.mjs",
    "coverage:report": "c8 report --reporter=text --reporter=lcov node --test test/*.test.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "socket.io-client": "^4.8.3"
  }
}
